  <diagram id="WL6gHW-gPUxR_1YAWZad" name="Stakeholders and sources">
    <mxGraphModel dx="1414" dy="751" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="7t2uB_CuHq424ETyKSrS-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Список стейкхолдеров&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ol&gt;&lt;li&gt;Команда проекта (руководитель, разработчики, тестировщики, дизайнеры) - отвечает за качественную реализацию системы.&amp;nbsp;&amp;nbsp;&lt;/li&gt;&lt;li&gt;Заказчик - заинтересован в получении системы в срок, в рамках бюджета&lt;/li&gt;&lt;li&gt;Отдел ИБ - отвечает за обеспечение конфиденциальности данных и соответствие политике безопасности.&lt;/li&gt;&lt;li&gt;Конечные пользователи - ждут простой и быстрый вход, удобный интерфейс, безопасность данных.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="40" y="130" as="geometry" />
        </mxCell>
        <mxCell id="86WVNZCPKajL8QsmRtac-1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;" value="&lt;div style=&quot;&quot;&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Список источников&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;Внешние/НПА:&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;ol&gt;&lt;li&gt;Документации OAuth 2.0 и&amp;nbsp;OIDC.&lt;/li&gt;&lt;li&gt;ФЗ-152 «О персональных данных».&lt;/li&gt;&lt;li&gt;Аналоги (например, Яндекс ID)&lt;/li&gt;&lt;/ol&gt;&lt;div&gt;Внутренние:&lt;/div&gt;&lt;div&gt;&lt;ol&gt;&lt;li&gt;Интервью с заказчиком.&lt;/li&gt;&lt;li&gt;Интервью с отделом ИБ.&lt;/li&gt;&lt;li&gt;Анкетирование пользователей.&lt;/li&gt;&lt;/ol&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="360" x="430" y="130" as="geometry" />
        </mxCell>
